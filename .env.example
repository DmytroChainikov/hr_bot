# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
ADMIN_CHAT_ID=your_admin_chat_id_here

# Allowed Group IDs (comma-separated, use /chat_info to get IDs)
# Example: ALLOWED_GROUP_IDS=-1001234567890,-1009876543210
ALLOWED_GROUP_IDS=

# Allowed Topic IDs (comma-separated, use /chat_info in topic to get IDs)
# If set, bot will ONLY work in these topics
# Example: ALLOWED_TOPIC_IDS=123,456,789
ALLOWED_TOPIC_IDS=

# Google Gemini AI (для природного спілкування бота)
# Отримати безкоштовний ключ: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Binotel API
BINOTEL_KEY=your_binotel_key_here
BINOTEL_SECRET=your_binotel_secret_here

# Hurma API
HURMA_API_KEY=your_hurma_api_key_here

# Hurma OAuth (optional, if using OAuth authentication)
HURMA_CLIENT_ID=your_client_id_here
HURMA_CLIENT_SECRET=your_client_secret_here
HURMA_USERNAME=your_email_here
HURMA_PASSWORD=your_password_here
HURMA_COMPANY=yourcompany

# HRs List 
# НОВИЙ ФОРМАТ: Name/username/telegram_id/HURMA_USER_ID/BINOTEL_INTERNAL_NUMBER
# telegram_id ОБОВ'ЯЗКОВИЙ для прихованого порівняння звітів!
# Приклад: HRS=Ірина/iryna/597392699/35/961,Вікторія/victoria/598765432/36/962
# 
# Як отримати telegram_id:
# 1. Відправте /start боту @userinfobot
# 2. Або використайте /chat_info команду вашого бота
HRS=Ірина/iryna/telegram_id/35/961

# Старий формат (без telegram_id) все ще підтримується, але порівняння не буде працювати:
# HRS=Ірина/iryna/35/961

# Note: Vacancy tracking is now managed via vacancies.json file
# Use /vacancies command to see tracked vacancies
